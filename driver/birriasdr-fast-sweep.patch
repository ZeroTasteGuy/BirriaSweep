diff --git a/firmware/iq_stream.S b/firmware/iq_stream.S
index 69745b5..f0558de 100644
--- a/firmware/iq_stream.S
+++ b/firmware/iq_stream.S
@@ -30,6 +30,9 @@ SOFTWARE.
 .equ SLOT_STRIDE, 0x3000
 .equ RING_COUNT, 0x4
 .equ PAYLOAD_BYTES, 0x2000
+.equ CTRL, 0x2041000
+.equ CTRL_MAGIC, 0x31525446
+.equ SPI_BASE, 0x7c004000
 /* SPDX-License-Identifier: MIT
  * Copyright (c) 2026 Luigi C. See LICENSE.
  * Original continuous ICAP SRAM -> serial USB DMA diagnostic.
@@ -199,6 +202,19 @@ fill_payload:
     movi $r0, 1
     swi $r0, [$fp + 28]
     dsb
+    .ifdef IQ_STREAM
+    /* On-chip retune control block: clear, then advertise support. */
+    load32 $r1, CTRL
+    movi $r0, 0
+    movi $r2, 12
+clear_ctrl:
+    swi.bi $r0, [$r1], 4
+    addi $r2, $r2, -1
+    bnez $r2, clear_ctrl
+    load32 $r1, CTRL
+    load32 $r0, CTRL_MAGIC
+    swi $r0, [$r1]
+    .endif
     load32 $r0, BOOT_MAGIC
     swi $r0, [$fp]
     dsb
@@ -265,6 +281,9 @@ snapshot_ready:
 publish:
     lwi $r0, [$fp + 36]
     bnez $r0, stopped
+    .ifdef IQ_STREAM
+    jal script_step
+    .endif
     lwi $r0, [$fp + 32]
     beqz $r0, next_packet
     beq $r4, $r0, done
@@ -284,6 +303,7 @@ wait_space:
     slli $r1, $r1, 11
     swi $r1, [$fp + 92]
     observe_source
+    jal script_step
     lwi $r0, [$r6 + 12]
     .endif
     .ifdef IQ_CAPTURE
@@ -307,6 +327,7 @@ space_ready:
 wait_source:
     lwi $r0, [$fp + 36]
     bnez $r0, stopped
+    jal script_step
     observe_source
     slti $r3, $r0, (PAYLOAD_BYTES / 4)
     beqz $r3, source_ready
@@ -413,6 +434,173 @@ timing_fault:
 source_overrun:
     movi $r10, 9
     j drain
+
+    /* SPI launch helpers: r3 = port << 13 | address. Scratch r0/r1. */
+    .macro spi_launch_read
+    load32 $r1, SPI_BASE
+    lwi $r0, [$r1 + 16]
+    srli $r0, $r0, 16
+    slli $r0, $r0, 16
+    or $r0, $r0, $r3
+    ori $r0, $r0, 0x1000
+    swi $r0, [$r1 + 16]
+    movi $r0, 0
+    swi $r0, [$r1 + 20]
+    .endm
+    /* r3 = port << 13 | address, r8 = value. */
+    .macro spi_launch_write
+    load32 $r1, SPI_BASE
+    lwi $r0, [$r1 + 16]
+    srli $r0, $r0, 16
+    slli $r0, $r0, 16
+    or $r0, $r0, $r3
+    swi $r0, [$r1 + 16]
+    swi $r8, [$r1 + 20]
+    .endm
+    .macro low24 reg
+    slli \reg, \reg, 8
+    srli \reg, \reg, 8
+    .endm
+    .macro set_phase value
+    movi $r0, \value
+    swi $r0, [$r9 + 32]
+    .endm
+
+script_step:
+    load32 $r9, CTRL
+    lwi $r0, [$r9 + 8]
+    lwi $r1, [$r9 + 12]
+    bne $r0, $r1, step_active
+    ret
+step_active:
+    lwi $r8, [$r9 + 44]
+    bnez $r8, step_started
+    lwi $r8, [$r9 + 4]
+    swi $r8, [$r9 + 44]
+    movi $r0, 0
+    swi $r0, [$r9 + 16]
+    swi $r0, [$r9 + 32]
+    load32 $r0, 0x89020068
+    lwi $r0, [$r0]
+    swi $r0, [$r9 + 36]
+step_started:
+    load32 $r0, SPI_BASE
+    lwi $r0, [$r0]
+    andi $r0, $r0, 2
+    beqz $r0, step_idle
+    ret
+step_idle:
+    lwi $r3, [$r8]
+    srli $r0, $r3, 24
+    beqz $r0, step_end
+    lwi $r1, [$r9 + 32]
+    bnez $r1, step_result
+    /* Phase 0: launch the op's first transaction. */
+    movi $r1, 1
+    beq $r0, $r1, launch_write_a
+    movi $r1, 2
+    beq $r0, $r1, launch_own_read
+    movi $r1, 3
+    beq $r0, $r1, launch_poll
+    movi $r1, 4
+    beq $r0, $r1, launch_latch
+    movi $r0, 3
+    swi $r0, [$r9 + 16]
+    j step_end
+launch_write_a:
+    low24 $r3
+    lwi $r8, [$r8 + 4]
+    spi_launch_write
+    j step_advance
+launch_poll:
+    load32 $r0, 0x89020068
+    lwi $r0, [$r0]
+    swi $r0, [$r9 + 24]
+launch_own_read:
+    low24 $r3
+    spi_launch_read
+    set_phase 1
+    ret
+launch_latch:
+    lwi $r3, [$r8 + 4]
+    spi_launch_read
+    set_phase 1
+    ret
+step_result:
+    /* Phase 1/2: the bridge is idle, so the read result is valid. */
+    load32 $r1, SPI_BASE
+    lwi $r0, [$r1 + 24]
+    lwi $r1, [$r9 + 32]
+    movi $r8, 2
+    beq $r1, $r8, latch_write
+    srli $r1, $r3, 24
+    movi $r8, 3
+    beq $r1, $r8, poll_result
+    movi $r8, 4
+    beq $r1, $r8, latch_source
+    /* Read-modify-write. */
+    lwi $r8, [$r9 + 44]
+    lwi $r1, [$r8 + 4]
+    bitc $r0, $r0, $r1
+    lwi $r1, [$r8 + 8]
+    or $r8, $r0, $r1
+    low24 $r3
+    spi_launch_write
+    j step_advance
+poll_result:
+    lwi $r8, [$r9 + 44]
+    lwi $r1, [$r8 + 4]
+    and $r0, $r0, $r1
+    lwi $r1, [$r8 + 8]
+    beq $r0, $r1, step_advance
+    load32 $r0, 0x89020068
+    lwi $r0, [$r0]
+    lwi $r1, [$r9 + 24]
+    sub $r0, $r0, $r1
+    movi $r1, 2000
+    slt $r0, $r1, $r0
+    beqz $r0, poll_again
+    movi $r0, 1
+    swi $r0, [$r9 + 16]
+    j step_advance
+poll_again:
+    low24 $r3
+    spi_launch_read
+    ret
+latch_source:
+    andi $r0, $r0, 7
+    slli $r0, $r0, 22
+    swi $r0, [$r9 + 40]
+    low24 $r3
+    spi_launch_read
+    set_phase 2
+    ret
+latch_write:
+    load32 $r1, 0x01c00000
+    bitc $r0, $r0, $r1
+    lwi $r1, [$r9 + 40]
+    or $r8, $r0, $r1
+    low24 $r3
+    spi_launch_write
+step_advance:
+    lwi $r8, [$r9 + 44]
+    addi $r8, $r8, 12
+    swi $r8, [$r9 + 44]
+    set_phase 0
+    ret
+step_end:
+    load32 $r0, 0x89020068
+    lwi $r0, [$r0]
+    lwi $r1, [$r9 + 36]
+    sub $r0, $r0, $r1
+    swi $r0, [$r9 + 20]
+    movi $r0, 0
+    swi $r0, [$r9 + 44]
+    dsb
+    lwi $r0, [$r9 + 8]
+    swi $r0, [$r9 + 12]   /* publish completion last */
+    dsb
+    ret
     .endif
     .size _start, .-_start
 
